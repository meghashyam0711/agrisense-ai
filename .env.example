# Application Settings
APP_NAME="Tamil Nadu AgriYield AI"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security / CORS
# Comma-separated or JSON list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,null"

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./data/agri_crop.db"

# Weather Integration
# OpenWeatherMap or Open-Meteo endpoint configuration
WEATHER_PROVIDER="open-meteo" # options: "open-meteo" (free, no key required) or "openweathermap"
OPENWEATHER_API_KEY="" # Required only if using openweathermap
WEATHER_API_TIMEOUT_SECONDS=5

# ML Model Paths
MODEL_PATH="./ml/saved_models/rf_paddy_yield_model.joblib"
FEATURE_COLUMNS_PATH="./ml/saved_models/feature_metadata.json"
